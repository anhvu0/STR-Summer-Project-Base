# Virtualenvs
/.venv/
/Lib/
/Scripts/

# Python caches
__pycache__/
*.pyc
.pytest_cache/

# Regenerable simulation outputs (kept on disk, not in git)
/scratch_braess/*/
/main_output/

# Paper working dir (has its own reproduce/ inside)
Selfless_routing/

# Logs, env, OS cruft
*.log
*.env
.DS_Store

# Docs are untracked by default, EXCEPT the reproduce guide and archive index
*.md
!reproduce/*.md
!archive/README.md
